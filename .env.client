# ============================================================
# Module Info
# ============================================================
MODULE_NAME="My Module"
MODULE_CODE=my_module
MODULE_VER=1.0.0.0

# ============================================================
# Author Info
# ============================================================
AUTHOR="Bariklabs"
AUTHOR_DOMAIN=https://bariklabs.com

# ============================================================
# OpenCart Version (used in distribution filename)
# ============================================================
OC_VERSION=3.0.3.9

# ============================================================
# FTP / SFTP Credentials (Demo Server)
# ============================================================
# Set IS_SFTP=true to use SFTP, false or leave empty for plain FTP
IS_SFTP=true

FTP_HOST=139.180.217.232
FTP_USERNAME=root
FTP_PASSWORD=Hp7QSTugHVg83qU

# Remote path on server (trailing slash required)
# Example: /public_html/demo/
FTP_PATH=/home/opencart/domains/demo08.bariklabs.com/public_html/

# ============================================================
# Rebuild Modification
# REBUILD_URL  : Base URL folder admin OC (tanpa trailing slash)
# REBUILD_TOKEN: "admin_username:admin_password" untuk login ke OC admin
# ============================================================
REBUILD_URL=https://demo08.bariklabs.com/admin
REBUILD_TOKEN=supporthpwd:rIdDRd3jkLGGjSu

# ============================================================
# Allow Update Flags
# Dipakai oleh module:push jika tidak ada flag --demo/--serverint/--serverlc
# ============================================================
ALLOW_UPDATE_INT=false
ALLOW_UPDATE_LC=false
ALLOW_UPDATE_CLIENT=false

# ============================================================
# Deploy — bariklabs.com (INT)
# Dipakai oleh module:push --serverint
# ============================================================
INT_IS_SFTP=true
INT_FTP_HOST=139.180.217.232
INT_FTP_USERNAME=root
INT_FTP_PASSWORD=Hp7QSTugHVg83qU
INT_FTP_PATH=/home/opencart/public_html/

INT_REBUILD_URL=https://bariklabs.com/blabs/
INT_REBUILD_TOKEN=bariklabs:rIdDRd3jkLGGjSu

# ============================================================
# Deploy — bariklabs.com (LC)
# Dipakai oleh module:push --serverlc
# ============================================================
LC_IS_SFTP=true
LC_FTP_HOST=139.180.217.232
LC_FTP_USERNAME=root
LC_FTP_PASSWORD=Hp7QSTugHVg83qU
LC_FTP_PATH=/home/opencart/public_html/

LC_REBUILD_URL=https://bariklabs.com/ocid?HrwCU1yt3o75
LC_REBUILD_TOKEN=opencartid:rIdDRd3jkLGGjSu

# ============================================================
# Distribution — bariklabs.com (INT)
# Dipakai oleh module:publish untuk upload zip + update DB
# ============================================================
DIST_INT_IS_SFTP=true
DIST_INT_FTP_HOST=139.180.217.232
DIST_INT_FTP_USERNAME=root
DIST_INT_FTP_PASSWORD=Hp7QSTugHVg83qU
DIST_INT_STORAGE_PATH=/home/opencart/public_html/storage/download/

DIST_INT_DB_HOST=localhost
DIST_INT_DB_USERNAME=opencartid
DIST_INT_DB_PASSWORD=fmaDCWC9aPpfjRU
DIST_INT_DB_DATABASE=opencart
DIST_INT_DB_PREFIX=bsml_

# ============================================================
# Distribution — bariklabs.com (LC)
# Dipakai oleh module:publish untuk upload zip + update DB
