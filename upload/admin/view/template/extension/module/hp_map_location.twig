{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
				<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>

	<div class="container-fluid">
		{% if error_warning %}
		<div class="alert alert-warning"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
		{% endif %}
		<div id="hpm-alert"></div>

		<div id="hpm-root" class="hpm" data-save="{{ ajax_save }}" data-fail="{{ error_request }}">

			<div class="hpm-ph">
				<div><h1>{{ heading_title2 }}</h1><p>{{ text_settings_sub }}</p></div>
				<div class="hpm-acts">
					<span class="hpm-un" id="hpm-un" hidden><i class="fa fa-exclamation-circle"></i> {{ text_unsaved }}</span>
					<button type="button" id="hpm-save" class="btn btn-primary" disabled><i class="fa fa-check"></i> {{ button_save }}</button>
				</div>
			</div>

			<div class="hpm-lay">
				<nav class="hpm-sn" role="tablist">
					<div class="hpm-sg">{{ text_group_settings }}</div>
					<a href="#hpm-general" data-hpm-tab="general" class="hpm-snav hpm-on"><i class="fa fa-sliders"></i> {{ text_tab_general }}</a>
					<a href="#hpm-messages" data-hpm-tab="messages" class="hpm-snav"><i class="fa fa-comment-o"></i> {{ text_tab_messages }}</a>
					<div class="hpm-sg">{{ text_group_system }}</div>
					<a href="#hpm-help" data-hpm-tab="help" class="hpm-snav"><i class="fa fa-question-circle"></i> {{ tab_help }}</a>
				</nav>

				<main class="hpm-main">
					<div class="hpm-pane hpm-on" id="hpm-general">
						<div class="hpm-card">
							<div class="hpm-card-h"><h3>{{ text_map_location }}</h3></div>
							<div class="hpm-row">
								<div class="hpm-row-l"><b>{{ entry_status }}</b></div>
								<div class="hpm-row-r">
									<label class="hpm-sw"><input type="checkbox" data-hpm-field name="status" value="1"{% if status %} checked{% endif %}><span></span></label>
								</div>
							</div>
							<div class="hpm-row">
								<div class="hpm-row-l"><b>{{ entry_compulsory }}</b><small>{{ help_compulsory }}</small></div>
								<div class="hpm-row-r">
									<label class="hpm-sw"><input type="checkbox" data-hpm-field name="compulsory" value="1"{% if compulsory %} checked{% endif %}><span></span></label>
								</div>
							</div>
							<div class="hpm-row">
								<div class="hpm-row-l"><b>{{ entry_force_map }}</b><small>{{ help_force_map }}</small></div>
								<div class="hpm-row-r">
									<label class="hpm-sw"><input type="checkbox" data-hpm-field name="force_map" value="1"{% if force_map %} checked{% endif %}><span></span></label>
								</div>
							</div>
							<div class="hpm-row hpm-stack">
								<div class="hpm-row-l"><b>{{ entry_map_api }}</b><small>{{ help_map_api }}</small></div>
								<div class="hpm-row-r">
									<input type="text" class="form-control" data-hpm-field name="api" value="{{ api }}" autocomplete="off">
								</div>
							</div>
						</div>
					</div>

					<div class="hpm-pane" id="hpm-messages">
						<div class="hpm-card">
							<div class="hpm-card-h"><h3>{{ text_tab_messages }}</h3></div>
							{% if languages|length > 1 %}
							<div class="hpm-seg" id="hpm-lang-seg">
								{% for language in languages %}
								<button type="button" data-hpm-lang="{{ language.language_id }}" class="{% if loop.first %}hpm-on{% endif %}">{{ language.name }}</button>
								{% endfor %}
							</div>
							{% endif %}
							{% for language in languages %}
							{% set message_value = _context['error_message_' ~ language.language_id] is defined ? _context['error_message_' ~ language.language_id] : '' %}
							{% set template_value = _context['share_location_template_' ~ language.language_id] is defined ? _context['share_location_template_' ~ language.language_id] : '' %}
							<div class="hpm-lang-pane{% if loop.first %} hpm-on{% endif %}" data-hpm-lang-pane="{{ language.language_id }}">
								<div class="hpm-row hpm-stack">
									<div class="hpm-row-l"><b>{{ entry_error_message }}</b><small>{{ help_error_message }}</small></div>
									<div class="hpm-row-r">
										<textarea rows="3" class="form-control" data-hpm-field name="error_message_{{ language.language_id }}">{{ message_value }}</textarea>
									</div>
								</div>
								<div class="hpm-row hpm-stack">
									<div class="hpm-row-l"><b>{{ entry_share_location_template }}</b><small>{{ help_share_location_template }}</small></div>
									<div class="hpm-row-r">
										<textarea rows="3" class="form-control" data-hpm-field name="share_location_template_{{ language.language_id }}">{{ template_value }}</textarea>
									</div>
								</div>
							</div>
							{% endfor %}
						</div>
					</div>

					<div class="hpm-pane" id="hpm-help">
						<div class="hpm-card hpm-helpcard">
							<div id="license"></div>
							<div id="support"></div>
						</div>
					</div>
				</main>
			</div>
		</div>
	</div>
</div>
<link href="view/stylesheet/hp_map_location/hpml_setting.css?v={{ version }}" rel="stylesheet" type="text/css">
<script src="view/javascript/hp_map_location/hpml_setting.js?v={{ version }}"></script>
<script type="text/javascript">
(function () {
	var loaded = false;
	function loadHelp() {
		if (loaded) { return; }
		loaded = true;
		$('#support').load('index.php?route=common/hp_validate/support&user_token={{ user_token }}');
		$('#license').load('index.php?route=common/hp_validate/license&user_token={{ user_token }}&code={{ extension_code }}&version={{ version }}');
	}
	$(document).on('click', '[data-hpm-tab="help"]', loadHelp);
	if (String(window.location.hash || '') === '#hpm-help') { $('[data-hpm-tab="help"]').trigger('click'); }

	$.get("https://bariklabs.com/index.php?route=common/extension/version&code={{ extension_code }}&oc=3.0.x.x", function (data) {
		var version = "{{ version }}".replace(/\D/g, '');
		var latest_version = String(data).replace(/\D/g, '');
		if (version < latest_version) {
			$('#hpm-alert').prepend('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ text_upgrade_version }}</div>');
		}
	});
})();
</script>
{{ footer }}
